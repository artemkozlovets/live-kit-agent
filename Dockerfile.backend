FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN useradd -m -u 10001 appuser

COPY requirements.backend.txt /app/requirements.backend.txt
RUN pip install --no-cache-dir -r /app/requirements.backend.txt

COPY api_server/ /app/api_server/

RUN chown -R appuser:appuser /app
USER appuser

# Railway provides $PORT; default to 8080 for local runs.
CMD ["sh", "-c", "uvicorn api_server.server.fastapi_app:app --host 0.0.0.0 --port ${PORT:-8080}"]

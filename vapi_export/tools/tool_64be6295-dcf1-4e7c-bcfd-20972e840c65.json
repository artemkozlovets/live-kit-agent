  "function": {
    "name": "extract_all_info",
    "description": "Extract ALL valuable information from the caller's message - customer details, service issues, vehicle info, location, and safety status. Call this immediately after the caller describes their situation.",
    "parameters": {
      "properties": {
        "customer_info": {
          "type": "object",
          "properties": {
            "company_name": {
              "description": "Company name if mentioned",
              "type": "string"
            },
            "email_address": {
              "description": "Email if provided",
              "type": "string"
            },
            "first_name": {
              "description": "Caller's first name",
              "type": "string"
            },
            "last_name": {
              "description": "Caller's last name",
              "type": "string"
            },
            "phone_number": {
              "description": "Phone number if provided",
              "type": "string"
            }
          },
          "description": "All customer-related information mentioned"
        },
        "location_info": {
          "type": "object",
          "properties": {
            "city": {
              "description": "City name",
              "type": "string"
            },
            "is_safe": {
              "description": "Whether caller indicated they are safe (true/false/null if not mentioned)",
              "type": "boolean"
            },
            "location_details": {
              "description": "Additional details (parking lot, mile marker, near X)",
              "type": "string"
            },
            "postal_code": {
              "description": "ZIP/Postal code if mentioned",
              "type": "string"
            },
            "state": {
              "description": "State (2-letter code if possible)",
              "type": "string"
            },
            "street_address": {
              "description": "Street address or landmark",
              "type": "string"
            }
          },
          "description": "All location-related information"
        },
        "raw_transcript": {
          "type": "string",
          "description": "The exact words the caller said (for reference)"
        },
        "service_info": {
          "type": "object",
          "properties": {
            "service_complaints": {
              "description": "List of all issues/complaints (e.g., 'flat tire', 'check engine light', 'need tow', 'battery dead', 'locked out')",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "service_type_needed": {
              "description": "Primary service type (roadside, tow, repair, etc.)",
              "type": "string"
            },
            "urgency": {
              "description": "Urgency level based on situation",
              "enum": [
                "low",
                "medium",
                "high",
                "emergency"
              ],
              "type": "string"
            }
          },
          "description": "All service-related issues mentioned"
        },
        "vehicle_info": {
          "type": "object",
          "properties": {
            "unit_nickname": {
              "description": "Vehicle nickname (e.g., 'Big Pete')",
              "type": "string"
            },
            "unit_number": {
              "description": "Fleet unit number if provided",
              "type": "string"
            },
            "vehicle_color": {
              "description": "Color if mentioned",
              "type": "string"
            },
            "vehicle_make": {
              "description": "Make (Ford, Kenworth, etc.)",
              "type": "string"
            },
            "vehicle_model": {
              "description": "Model if mentioned",
              "type": "string"
            },
            "vehicle_type": {
              "description": "Type of vehicle (truck, semi, car, etc.)",
              "type": "string"
            },
            "vehicle_year": {
              "description": "Year if mentioned",
              "type": "string"
            },
            "vin_number": {
              "description": "VIN if provided",
              "type": "string"
            }
          },
          "description": "All vehicle-related information"
        }
      },
      "required": [
        "raw_transcript"
      ],
      "type": "object"
    }
  },
  "createdAt": "2026-01-15T20:01:42Z",
  "updatedAt": "2026-01-15T20:01:42Z",
  "type": "function"
}

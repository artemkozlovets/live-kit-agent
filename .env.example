# Copy to `.env` and fill in real values (never commit `.env`).

# --- Backend tools auth (api_server) ---
TOOLS_TOKEN=dev-secret

# --- Database ---
# Use Postgres in production (Railway sets DATABASE_URL).
# For local dev without Postgres:
USE_IN_MEMORY_DB=1
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Twilio SMS (optional) ---
# When configured, `send_confirmation_sms` will send an SMS via Twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Choose ONE:
TWILIO_SMS_FROM_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Delivery tracking (optional):
# Point this at your deployed backend (Railway) so Twilio can POST status updates.
# TWILIO_WEBHOOK_TOKEN=change-me
# TWILIO_STATUS_CALLBACK_URL=https://<your-railway-domain>/twilio/status-callback?token=change-me


            "Just checking \u2014 are you still there?",
            "No rush. I can continue when you're ready.",
            "I'm here when you're ready to continue."
          ]
        }
      ],
      "on": "customer.speech.timeout",
      "name": "idle-reengage",
      "options": {
        "timeoutSeconds": 10,
        "triggerMaxCount": 3,
        "triggerResetMode": "onUserSpeech"

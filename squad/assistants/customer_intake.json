            "updates": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string",
                  "description": "New city"
                },
                "state": {
                  "type": "string",
                  "description": "New state (2-letter code)"
                },
                "last_name": {
                  "type": "string",

{
  "name": "CustomerIntake",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_case_status",
        "parameters": {
          "type": "object",
          "required": ["last_user_message"],
          "properties": {
            "last_user_message": {
              "type": "string",
              "description": "The user's most recent message, exactly as they said it"
            }
          }
        },
        "description": "Get case status and determine how to respond. ALWAYS pass the user's last message."
      }
    },
    {
      "type": "function",
      "function": {
        "name": "validate_phone",
        "parameters": {
          "type": "object",
          "required": ["phone_number"],
          "properties": {
            "phone_number": {
              "type": "string",
              "description": "Phone number to validate"
            }
          }
        },
        "description": "Validate phone number and check if it can receive SMS."
      }
    },
    {
      "type": "function",
      "function": {
        "name": "check_customer",
        "parameters": {
          "type": "object",
          "required": ["phone_number"],
          "properties": {
            "known_data": {
              "type": "object",
              "properties": {
                "city": { "type": "string" },
                "state": { "type": "string" },
                "last_name": { "type": "string" },
                "first_name": { "type": "string" },
                "postalCode": { "type": "string" },
                "company_name": { "type": "string" },
                "email_address": { "type": "string" },
                "streetAddress": { "type": "string" }
              },
              "description": "All customer data already collected in this conversation"
            },
            "phone_number": {
              "type": "string",
              "description": "Phone number to lookup"
            }
          }
        },
        "description": "Check if a customer exists by phone number."
      }
    },
    {
      "type": "function",
      "function": {
        "name": "register_new_customer",
        "parameters": {
          "type": "object",
          "required": [
            "first_name",
            "last_name",
            "company_name",
            "email_address",
            "phone_number",
            "streetAddress",
            "city",
            "state",
            "postalCode"
          ],
          "properties": {
            "city": { "type": "string", "description": "City" },
            "state": { "type": "string", "description": "State (2-letter code)" },
            "country": { "type": "string", "description": "Country (optional)" },
            "last_name": { "type": "string", "description": "Customer last name" },
            "first_name": { "type": "string", "description": "Customer first name" },
            "postalCode": { "type": "string", "description": "Postal code" },
            "company_name": { "type": "string", "description": "Company name" },
            "phone_number": { "type": "string", "description": "Customer phone number" },
            "email_address": { "type": "string", "description": "Customer email address" },
            "streetAddress": { "type": "string", "description": "Street address" },
            "marketing_source": { "type": "string", "description": "Where the customer heard about us (optional)" },
            "customer_position": { "type": "string", "description": "Customer's position or role (optional)" }
          }
        },
        "description": "Register a new customer (backend-shaped fields)."
      }
    },
    {
      "type": "function",
      "function": {
        "name": "update_customer",
        "parameters": {
          "type": "object",
          "required": ["updates"],
          "properties": {
            "updates": {
              "type": "object",
              "properties": {
                "city": { "type": "string", "description": "New city" },
                "state": { "type": "string", "description": "New state (2-letter code)" },
                "last_name": { "type": "string", "description": "New last name" },
                "first_name": { "type": "string", "description": "New first name" },
                "postalCode": { "type": "string", "description": "New postal code" },
                "company_name": { "type": "string", "description": "New company name" },
                "phone_number": { "type": "string", "description": "New phone number (E.164 format)" },
                "email_address": { "type": "string", "description": "New email address" },
                "streetAddress": { "type": "string", "description": "New street address" }
              },
              "description": "Only include fields that need to be changed"
            },
            "customer_id": {
              "type": "string",
              "description": "The existing customer's ID from the system (if known)"
            },
            "phone_number": {
              "type": "string",
              "description": "Current phone number to identify the customer (E.164 format)"
            }
          }
        },
        "description": "Update an existing customer's information. Use this when a caller wants to change or correct ANY of their details (name, email, phone, address, company) AFTER they have already been registered. Only pass the fields that need to be updated."
      }
    }
  ]
}

{
  "name": "ServiceCollection",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_case_status",
        "parameters": {
          "type": "object",
          "required": ["last_user_message"],
          "properties": {
            "last_user_message": {
              "type": "string",
              "description": "The user's most recent message, exactly as they said it"
            }
          }
        },
        "description": "Get case status and determine how to respond. ALWAYS pass the user's last message."
      }
    },
    {
      "type": "function",
      "function": {
        "name": "validate_vin",
        "parameters": {
          "type": "object",
          "required": ["vin"],
          "properties": {
            "vin": { "type": "string", "description": "Vehicle Identification Number (VIN)" }
          }
        },
        "description": "Validate VIN format and track attempts across the call session."
      }
    },
    {
      "type": "function",
      "function": {
        "name": "check_vin_database",
        "parameters": {
          "type": "object",
          "required": ["vin"],
          "properties": {
            "vin": { "type": "string", "description": "VIN to lookup in fleet database" }
          }
        },
        "description": "Check if VIN exists in the customer's fleet database."
      }
    },
    {
      "type": "function",
      "function": {
        "name": "add_service",
        "parameters": {
          "type": "object",
          "required": ["vehicle_identifier_type", "vehicle_identifier", "service_complaint", "service_location"],
          "properties": {
            "vehicle_identifier_type": {
              "type": "string",
              "enum": ["vin", "unit_number", "unit_nickname"],
              "description": "Type of vehicle identifier provided"
            },
            "vehicle_identifier": { "type": "string", "description": "Vehicle identifier value (VIN, unit number, or nickname)" },
            "service_location": { "type": "string", "description": "Where the vehicle is located" },
            "service_complaint": { "type": "string", "description": "What service is needed" },
            "vehicle_make": { "type": "string", "description": "Vehicle make (ex: Ford)" },
            "vehicle_model": { "type": "string", "description": "Vehicle model (ex: F-150)" }
          }
        },
        "description": "Add a service to the session for later storage. Always include vehicle_identifier_type + vehicle_identifier."
      }
    },
    {
      "type": "function",
      "function": {
        "name": "confirm_services",
        "parameters": { "type": "object", "properties": {} },
        "description": "Mark services as confirmed after summarizing to the caller."
      }
    },
    {
      "type": "function",
      "function": {
        "name": "update_customer",
        "parameters": {
          "type": "object",
          "required": ["updates"],
          "properties": {
            "updates": {
              "type": "object",
              "properties": {
                "city": { "type": "string" },
                "state": { "type": "string" },
                "last_name": { "type": "string" },
                "first_name": { "type": "string" },
                "postalCode": { "type": "string" },
                "company_name": { "type": "string" },
                "phone_number": { "type": "string" },
                "email_address": { "type": "string" },
                "streetAddress": { "type": "string" }
              }
            },
            "customer_id": { "type": "string" },
            "phone_number": { "type": "string" }
          }
        },
        "description": "Update an existing customer's information."
      }
    },
    {
      "type": "function",
      "function": {
        "name": "update_service_order",
        "parameters": {
          "type": "object",
          "required": ["updates"],
          "properties": {
            "updates": {
              "type": "object",
              "properties": {
                "vin_number": { "type": "string" },
                "unit_number": { "type": "string" },
                "unit_nickname": { "type": "string" },
                "service_location": { "type": "string" },
                "service_complaint": { "type": "string" },
                "vehicle_make": { "type": "string" },
                "vehicle_model": { "type": "string" }
              }
            },
            "order_id": { "type": "string" }
          }
        },
        "description": "Update an existing service order's details."
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_session_summary",
        "parameters": { "type": "object", "required": [], "properties": {} },
        "description": "Get the accumulated service list for this call."
      }
    }
  ]
}
